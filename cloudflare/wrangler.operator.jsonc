{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "serp-dev-lago-operator",
  "account_id": "cec5f04e1d18bcc65f2be0aefb04f059",
  "main": "src/operator/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "operator-app",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/ready"],
  },
  "vars": {
    "APP_ENV": "development",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CREDIT_NOTE_REFUND_MODE": "disabled",
    "OPERATOR_ACCESS_ENABLED": "1",
    "ACCESS_TEAM_DOMAIN": "https://serpcompany.cloudflareaccess.com",
    "ACCESS_AUD": "4e2aeb75eccbd0abda500c9318a371acbeab7a244f8727904358021daea5a951",
  },
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "BILLING_DB",
      "database_name": "serp-dev-lago-native-d1",
      "database_id": "2f32f159-c269-46c6-a4dd-9e38477f5d25",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BILLING_ARTIFACTS",
      "bucket_name": "serp-dev-lago-native-billing-artifacts",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BILLING_ACCOUNTS",
        "class_name": "BillingAccount",
        "script_name": "serp-dev-lago-native",
      },
    ],
  },
  "workflows": [
    {
      "name": "serp-dev-lago-plan-deletion",
      "binding": "PLAN_DELETION_WORKFLOW",
      "class_name": "PlanDeletionWorkflow",
      "script_name": "serp-dev-lago-native",
    },
    {
      "name": "serp-dev-lago-documents",
      "binding": "DOCUMENT_WORKFLOW",
      "class_name": "DocumentWorkflow",
      "script_name": "serp-dev-lago-native",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOMAIN_EVENTS",
        "queue": "serp-dev-lago-domain-events",
      },
    ],
  },
}
